---
/**
 * Practice block for a lesson. Items and cards come from data/exercises/{module}/{lesson}.yaml.
 * Exercises need an account (Round 1 decision): the island shows a sign-in link to guests.
 */
import { getEntry } from "astro:content";
import PracticeSession from "../islands/PracticeSession.tsx";

interface Props {
  /** what the practice covers, listed for everyone */
  skills: string[];
  /** legacy prop, ignored: the count comes from the data file */
  items?: number;
}
const { skills } = Astro.props;
const lessonId = Astro.url.pathname.replace(/^\/course\//, "").replace(/\/$/, "");
const ex = await getEntry("exercises", lessonId);
---
<section class="practice" aria-labelledby="practice-h">
  <h2 id="practice-h">Practice</h2>
  {ex && <p>{ex.data.items.length} questions on:</p>}
  <ul>
    {skills.map((s) => <li>{s}</li>)}
  </ul>
  {
    ex ? (
      <PracticeSession client:visible lessonId={lessonId} items={ex.data.items} cards={ex.data.cards.map((c) => c.id)} />
    ) : (
      <p class="practice-note">Practice for this lesson is in preparation.</p>
    )
  }
</section>

<style>
  @layer molecules {
    .practice {
      clear: both;
      margin-block-start: var(--s-stack-xl);
      padding: var(--p-space-5) var(--p-space-5) var(--p-space-6);
      border: 1px solid var(--s-color-border);
      border-radius: var(--s-radius-control);
    }
    .practice h2 { margin: 0 0 var(--p-space-3); }
    .practice > ul { margin-block: var(--p-space-2) var(--p-space-4); }
  }
</style>
