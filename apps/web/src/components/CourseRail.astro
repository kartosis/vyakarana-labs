---
/** Course contents in LSK order. Desktop: sticky rail. Mobile: a disclosure above the lesson. */
import { publishedLessons } from "../lib/published";
import { getCollection } from "astro:content";

interface Props {
  currentModule?: string;
  currentLesson?: string;
}
const { currentModule, currentLesson } = Astro.props;
const modules = (await getCollection("modules")).sort((a, b) => a.data.order - b.data.order);
const lessons = await publishedLessons();
const byModule = (m: string) =>
  lessons.filter((l) => l.data.module === m).sort((a, b) => a.data.order - b.data.order);
const lessonSlug = (id: string) => id.split("/").pop();
---
{
  [
    { cls: "rail rail--desktop", wrap: false },
    { cls: "rail rail--mobile", wrap: true },
  ].map(({ cls, wrap }) => {
    const list = (
      <ol class="rail-modules">
        {modules.map((m) => {
          const ls = byModule(m.id);
          const isCur = m.id === currentModule;
          return (
            <li class:list={["rail-module", { "is-current": isCur, "is-soon": m.data.status === "soon" }]}>
              {m.data.status === "open" && ls.length > 0 ? (
                <a href={`/course/${m.id}/${lessonSlug(ls[0]!.id)}/`} class="rail-module-link">
                  <span class="rail-deva" lang="sa">{m.data.deva}</span>
                  <span class="rail-title">{m.data.title}</span>
                </a>
              ) : (
                <span class="rail-module-link">
                  <span class="rail-deva" lang="sa">{m.data.deva}</span>
                  <span class="rail-title">{m.data.title} <span class="rail-soon">in preparation</span></span>
                </span>
              )}
              {(isCur || wrap) && ls.length > 0 && (
                <ol class="rail-lessons">
                  {ls.map((l) => {
                    const slug = lessonSlug(l.id);
                    const cur = isCur && slug === currentLesson;
                    return (
                      <li>
                        <a href={`/course/${m.id}/${slug}/`} aria-current={cur ? "page" : undefined}>
                          {l.data.title}
                        </a>
                      </li>
                    );
                  })}
                </ol>
              )}
            </li>
          );
        })}
      </ol>
    );
    return wrap ? (
      <details class={cls}>
        <summary>Course contents</summary>
        <nav aria-label="Course contents">{list}</nav>
      </details>
    ) : (
      <nav class={cls} aria-label="Course contents">
        <p class="rail-heading"><a href="/course/">Laghusiddhāntakaumudī path</a></p>
        {list}
      </nav>
    );
  })
}

<style>
  @layer organisms {
    .rail { font-size: var(--s-text-small); }
    .rail--desktop {
      display: none;
      position: sticky;
      inset-block-start: calc(var(--s-header-h) + var(--p-space-4));
      max-block-size: calc(100dvh - var(--s-header-h) - var(--p-space-6));
      overflow-y: auto;
      padding-block: var(--p-space-6);
      padding-inline-end: var(--p-space-3);
      scrollbar-width: thin;
    }
    .rail-heading { margin: 0 0 var(--p-space-3); font-weight: 700; }
    .rail-heading a { color: var(--s-color-text); text-decoration: none; }
    .rail ol { list-style: none; margin: 0; padding: 0; }
    .rail-modules { counter-reset: mod -1; display: grid; gap: var(--p-space-1); }
    .rail-module { counter-increment: mod; }
    .rail-module-link {
      display: grid;
      grid-template-columns: 1.6rem 1fr;
      column-gap: var(--p-space-2);
      padding: 0.3rem 0.4rem;
      border-radius: var(--s-radius-control);
      color: var(--s-color-text-soft);
      text-decoration: none;
      line-height: 1.3;
    }
    .rail-module-link::before {
      content: counter(mod);
      grid-row: span 2;
      color: var(--s-color-rubric);
      font-variant-numeric: tabular-nums;
      text-align: end;
    }
    a.rail-module-link:hover { background: var(--s-color-leaf); color: var(--s-color-text); }
    .rail-deva { font-family: var(--s-font-sanskrit); font-size: 1rem; color: var(--s-color-text); }
    .is-soon .rail-deva { color: var(--s-color-text-faint); }
    .rail-soon { display: block; font-style: italic; color: var(--s-color-text-faint); }
    .is-current > .rail-module-link { background: var(--s-color-leaf); }
    .rail-lessons {
      display: grid;
      gap: 0.15rem;
      margin: var(--p-space-1) 0 var(--p-space-2) 2.4rem !important;
      border-inline-start: 1px solid var(--s-color-hairline);
    }
    .rail-lessons a {
      display: block;
      padding: 0.2rem 0.6rem;
      color: var(--s-color-text-soft);
      text-decoration: none;
      margin-inline-start: -1px;
      border-inline-start: 2px solid transparent;
    }
    .rail-lessons a:hover { color: var(--s-color-text); }
    .rail-lessons a[aria-current="page"] {
      color: var(--s-color-text);
      font-weight: 700;
      border-inline-start-color: var(--s-color-rubric);
    }

    .rail--mobile {
      margin-block-start: var(--p-space-4);
      padding: var(--p-space-2) var(--p-space-4);
      border: 1px solid var(--s-color-border);
      border-radius: var(--s-radius-control);
    }
    .rail--mobile summary { cursor: pointer; font-weight: 700; min-block-size: 2rem; display: flex; align-items: center; }
    .rail--mobile[open] summary { margin-block-end: var(--p-space-3); }

    @media (width >= 64rem) {
      .rail--desktop { display: block; }
      .rail--mobile { display: none; }
    }
  }
</style>
