---
import Base from "../layouts/Base.astro";
import { beaconToken } from "../lib/analytics";
---
<Base title="Privacy" description="What Vyākaraṇa Labs stores and why.">
  <div class="page-narrow prose">
    <header class="page-head">
      <h1>Privacy</h1>
      <p class="lead">This site stores as little as it can and never sells or shares anything.</p>
    </header>
    <h2>Without an account</h2>
    <ul>
      <li>Your script and theme choices, and the lessons you mark as read, are kept in your own browser's storage. They never leave your device.</li>
      {beaconToken ? (
        <li>Page visits are counted with Cloudflare Web Analytics: cookieless and aggregate. No cookies, no cross-site tracking, no personal profile.</li>
      ) : (
        <li>Page visits are not counted.</li>
      )}
    </ul>
    <h2>With an account</h2>
    <ul>
      <li>Your email address, used only to send sign-in codes.</li>
      <li>Your learning record: lessons completed, practice results, review schedule, streak, notes and highlights.</li>
      <li>A pseudonym for the weekly leaderboard, which you can change or opt out of.</li>
    </ul>
    <p>You can download everything stored about you, or delete your account and all its data, from your settings.
      After a deletion, a marker holding only the account's internal number (no email, no learning data) is kept for
      one day, so that a browser tab still open elsewhere cannot bring the account back.</p>
  </div>
</Base>
