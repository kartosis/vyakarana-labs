---
import { publishedLessons } from "../../lib/published";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SutraFolio from "../../components/SutraFolio.astro";
import { devaToIast } from "../../lib/sanskrit";
import { pramanaCommentary, pramanaLink } from "../../lib/pramana";

export async function getStaticPaths() {
  const sutras = await getCollection("sutras");
  return sutras.map((s) => ({ params: { id: s.id }, props: { sutra: s } }));
}
const { sutra } = Astro.props;
const id = sutra.id;
const [a] = id.split(".");
const allLessons = await publishedLessons();
const lessons = allLessons.filter((l) => l.data.sutras.includes(id));
// lessons that cite the sūtra in passing (SutraRef / SutraFolio in the body) without teaching it
const citedIn = allLessons.filter((l) => !lessons.includes(l) && (l.body ?? "").includes(`id="${id}"`));
const lessonHref = (l: (typeof allLessons)[number]) => `/course/${l.data.module}/${l.id.split("/").pop()}/`;
const link = pramanaLink(id);
const iast = devaToIast(sutra.data.deva);
---
<Base title={`${id} ${iast}`} description={`Aṣṭādhyāyī ${id}, ${iast}: ${sutra.data.meaning}`}>
  <div class="page-narrow">
    <header class="page-head">
      <p class="crumbs"><a href="/sutras/">Sūtras</a> / Aṣṭādhyāyī {id}</p>
    </header>
    <SutraFolio id={id} level={1} />

    <section class="sutra-more" aria-labelledby="taught-h">
      <h2 id="taught-h">Where it is taught</h2>
      {
        lessons.length > 0 && (
          <ul>
            {lessons.map((l) => (
              <li><a href={lessonHref(l)}>{l.data.title}</a></li>
            ))}
          </ul>
        )
      }
      {
        citedIn.length > 0 && (
          <p>{lessons.length ? "Also cited in" : "Cited in"} {citedIn.map((l, i) => <>{i > 0 && (i === citedIn.length - 1 ? " and " : ", ")}<a href={lessonHref(l)}>{l.data.title}</a></>)}.</p>
        )
      }
      {lessons.length === 0 && citedIn.length === 0 && <p>Its lesson is in preparation.</p>}
    </section>

    <section class="sutra-more" aria-labelledby="read-h">
      <h2 id="read-h">Read further</h2>
      <ul>
        <li>
          <a href={link.href} rel="external">{link.exact ? `Aṣṭādhyāyī ${id} on Pramāṇa` : `Pāda ${id.split(".").slice(0, 2).join(".")} on Pramāṇa`}</a>
          {!link.exact && <span class="sutra-note"> (Pramāṇa does not yet have a page for this sūtra)</span>}
        </li>
        <li><a href={pramanaCommentary.kasika} rel="external">Kāśikāvṛtti</a> and <a href={pramanaCommentary.mahabhasya} rel="external">Mahābhāṣya</a> catalogue entries on Pramāṇa</li>
        <li>
          <a href="https://ashtadhyayi.com/" rel="external">ashtadhyayi.com</a>
          <span class="sutra-note"> (look up {id}): the Kāśikā, Mahābhāṣya, Siddhāntakaumudī, Bālamanoramā and more, from the dataset this site draws on</span>
        </li>
        <li>
          <a href={`https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/${a}/${id}.htm`} rel="external">Commentaries on {id}</a>
          <span class="sutra-note"> at sanskritdocuments.org: Kāśikā, Nyāsa, Bālamanoramā and the Laghusiddhāntakaumudī where available</span>
        </li>
      </ul>
    </section>
  </div>
</Base>

<style>
  @layer pages {
    .sutra-more { margin-block-start: var(--s-stack-l); }
    .sutra-more h2 { font-size: var(--s-text-h3); margin-block-end: var(--p-space-3); }
    .sutra-more ul { display: grid; gap: var(--p-space-2); padding-inline-start: 1.2em; margin: 0; }
    .sutra-note { color: var(--s-color-text-faint); font-size: var(--s-text-small); }
  }
</style>
