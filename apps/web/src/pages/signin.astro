---
import Base from "../layouts/Base.astro";
import SignIn from "../islands/SignIn.tsx";
---
<Base title="Sign in" description="Sign in to Vyākaraṇa Labs with a one-time code sent to your email.">
  <div class="page-narrow">
    <header class="page-head">
      <h1>Sign in</h1>
      <p class="lead">An account saves your practice and schedules your reviews. There is no password: enter your email and we send you a code.</p>
    </header>
    <SignIn client:load />
    <p class="signin-note">New here? The same form creates your account. See what is stored on the <a href="/privacy/">privacy page</a>.</p>
  </div>
</Base>
<style>
  @layer pages {
    :global(.signin form) { display: grid; gap: var(--p-space-3); max-inline-size: 28rem; }
    :global(.signin label) { font-weight: 700; }
    :global(.signin .btn) { justify-self: start; }
    :global(.signin .btn[disabled]) { opacity: 0.6; cursor: progress; }
    :global(.signin-status),
    :global(.signin-sent) { color: var(--s-color-text-soft); padding: var(--p-space-4); background: var(--s-color-leaf); border-radius: var(--s-radius-control); max-inline-size: 40rem; }
    :global(.signin-error) { color: var(--s-color-rubric); font-weight: 700; margin-block-start: var(--p-space-3); }
    .signin-note { margin-block-start: var(--s-stack-l); font-size: var(--s-text-small); color: var(--s-color-text-faint); }
  }
</style>
