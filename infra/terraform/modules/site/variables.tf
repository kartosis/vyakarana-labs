variable "name" {
  description = "Short prefix for resource names"
  type        = string
  default     = "vl"
}

variable "domain_name" {
  description = "Custom host name, e.g. sanskrit.identifyragas.com. Empty = CloudFront default domain only."
  type        = string
  default     = ""
}

variable "acm_validated" {
  description = "Phase 2 switch: set true once the ACM validation CNAME exists in DNS, to attach the domain."
  type        = bool
  default     = false
}

variable "price_class" {
  description = "PriceClass_100 = North America + Europe edges (cheapest; free tier applies to all classes)."
  type        = string
  default     = "PriceClass_100"
}

variable "csp_script_hashes" {
  description = "'sha256-…' sources for inline scripts, generated by scripts/csp-hashes.mjs"
  type        = list(string)
  default     = []
}

variable "csp_style_hashes" {
  description = "'sha256-…' sources for inline styles, generated by scripts/csp-hashes.mjs"
  type        = list(string)
  default     = []
}

variable "csp_extra_script_src" {
  description = "Extra script origins (e.g. Cloudflare Web Analytics)"
  type        = list(string)
  default     = []
}

variable "csp_extra_connect_src" {
  description = "Extra connect-src origins (e.g. Cognito, analytics beacon)"
  type        = list(string)
  default     = []
}

variable "api_origin" {
  description = "Optional API origin served at /api/* (Lambda Function URL with OAC). Added in milestone M3."
  type = object({
    domain_name              = string
    oac_id                   = string
    origin_request_policy_id = string
  })
  default = null
}
